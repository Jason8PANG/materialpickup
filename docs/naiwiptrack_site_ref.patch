       - "CSI_USERNAME=NAIGROUP_PRD#2VuvOcvlyIej1k2YlORMyLgB0Ttgu7xDtvpwJle9EA3rbhfmSQKtnHnnc8ze7tPaY_SFOPjvb6Q2RV2kfro8ag"
